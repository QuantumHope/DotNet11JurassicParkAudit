<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>
  <ItemGroup>
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Sqlite" Version="11.0.0-rc.2.26504.105" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="11.0.0-rc.2.26504.105" />
    <!-- The AI stack isn't tied to .NET 11: these versions also run on .NET 10 LTS. -->
    <PackageVersion Include="Microsoft.Extensions.AI" Version="10.11.0" />
    <PackageVersion Include="OllamaSharp" Version="5.5.0" />
    <PackageVersion Include="MonoGame.Framework.DesktopGL" Version="3.8.6" />
    <PackageVersion Include="SadConsole.Host.MonoGame" Version="10.10.1" />
  </ItemGroup>
</Project>
